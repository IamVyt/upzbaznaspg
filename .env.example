APP_NAME="UPZ BAZNAS Petrokimia Gresik"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database lokal (default, tanpa server DB) ---
# File SQLite dibuat otomatis oleh "composer setup", atau manual:
# php -r "file_exists('database/database.sqlite') || touch('database/database.sqlite');"
DB_CONNECTION=sqlite
# DB_DATABASE=/path/absolut/ke/database/database.sqlite

# --- Database produksi PostgreSQL (Supabase / Render / Neon) ---
# Aktifkan blok ini dan isi kredensial dari dashboard penyedia database.
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.xxxxxxxxxxxxxxxxxxxx
# DB_PASSWORD=
# DB_SSLMODE=require

# Alternatif: satu variabel connection URL dari Supabase:
# DB_URL=postgresql://postgres.xxxxxxxx:password@host:5432/postgres?sslmode=require

# Driver session & cache dibaca dari environment (default: file).
# Di belakang proxy, isi TRUSTED_PROXIES dengan IP/CIDR proxy yang dipercaya;
# gunakan * hanya bila aplikasi selalu berada di belakang proxy platform.
# TRUSTED_PROXIES=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib "true" di production yang memakai HTTPS:
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="upzpkg@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Catatan: dengan MAIL_MAILER=log, link verifikasi dan reset password hanya tercatat di storage/logs/laravel.log.
#
# Untuk production di Render free, port SMTP (25/465/587) diblokir.
# Gunakan Resend API yang berjalan lewat HTTPS:
# MAIL_MAILER=resend
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_FROM_ADDRESS=no-reply@domain-anda.com
# MAIL_FROM_NAME="${APP_NAME}"
#
# Untuk SMTP biasa di lokal/hosting yang mengizinkan port SMTP:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=alamat@example.com
# MAIL_PASSWORD=password-aplikasi
# MAIL_SCHEME=null
